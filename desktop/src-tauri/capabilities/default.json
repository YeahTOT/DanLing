{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main desktop pet window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "danling-config-tui",
          "cmd": "danling",
          "args": ["config", "tui"],
          "sidecar": false
        },
        {
          "name": "danling-api",
          "cmd": "danling",
          "args": [
            "api",
            "--host",
            "127.0.0.1",
            "--port",
            {
              "validator": "[0-9]{2,5}"
            },
            "--no-hardware"
          ],
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "danling-config-tui",
          "cmd": "danling",
          "args": ["config", "tui"],
          "sidecar": false
        },
        {
          "name": "danling-api",
          "cmd": "danling",
          "args": [
            "api",
            "--host",
            "127.0.0.1",
            "--port",
            {
              "validator": "[0-9]{2,5}"
            },
            "--no-hardware"
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
